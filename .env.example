# Roboflow hosted classification API
# Get the API key at https://app.roboflow.com -> Settings -> Roboflow API
ROBOFLOW_API_KEY=your_key_here

# Slug shown in your Roboflow project URL: https://app.roboflow.com/<workspace>/<project>
# Use the form "workspace/project"
ROBOFLOW_PROJECT_ID=your-workspace/your-project

# Trained model version number (integer shown next to "Versions" in the project)
ROBOFLOW_MODEL_VERSION=1

# Inferences below this confidence are flagged for review and uploaded back to Roboflow
ROBOFLOW_CONFIDENCE_THRESHOLD=0.6

# Set to false to disable the active-learning upload while still flagging rows
ROBOFLOW_UPLOAD_ON_LOW_CONF=true
